  "business_rules": [
    {
      "rule_id": "BR_001",
      "rule_name": "Summer VS Winter (Seasonality)",
      "category": "Demand Forecasting",
      "description": "Ice-creams, Cold drinks, Mangos sales increase during summers. While soups, coffee, tea, dry fruits sales increase during winters.",
      "logic": "IF month IN [Mar, Apr, May, Jun] THEN increase multiplier for [Cold Beverages, Ice Creams, Mangoes]. IF month IN [Nov, Dec, Jan] THEN increase multiplier for [Hot Beverages, Soups, Dry Fruits]."
    },
    {
      "rule_id": "BR_002",
      "rule_name": "UPI vs COD by City Tier",
      "category": "Payments",
      "description": "Customers in large cities (metro cities) prefer UPI more over COD while in small cities people prefer COD more. (Bengaluru defaults heavily to UPI).",
      "logic": "IF city == 'Bengaluru' THEN set UPI probability >= 0.5 AND COD probability <= 0.15."
    },
    {
      "rule_id": "BR_003",
      "rule_name": "Grocery Dominates Pet care & Electronics",
      "category": "Inventory & Cart",
      "description": "Grocery, snacks, beverages, food products, etc are ordered more as compared to electronic items.",
      "logic": "Enforce cart composition ratio: 85% FMCG/Grocery : 10% Personal/Pet Care : 5% Electronics/General Merchandise."
    },
    {
      "rule_id": "BR_004",
      "rule_name": "High Rated Riders Get More Deliveries",
      "category": "Logistics Allocation",
      "description": "Riders with higher rating are given frequent and repeated deliveries.",
      "logic": "IF rider_rating > 4.5 THEN assignment_weight = +20%."
    },
    {
      "rule_id": "BR_005",
      "rule_name": "Priority Batching",
      "category": "Logistics Allocation",
      "description": "IF a rider has a rating above 4.8 and a low cancellation rate, THEN the algorithm prioritizes them for 'batched orders'.",
      "logic": "IF rider_rating >= 4.8 AND rider_cancellation_rate < 0.02 AND active_orders_in_radius >= 2 THEN assign batched_delivery."
    },
    {
      "rule_id": "BR_006",
      "rule_name": "Heavy Rainfall Delays & Cancellations",
      "category": "Operations & SLAs",
      "description": "Heavy rainfall can cause delayed deliveries & cancellation.",
      "logic": "IF weather_condition == 'Heavy Rain' THEN increase ETA by 15 mins AND allow force_cancellation = TRUE AND shrink_serviceable_radius by 50%."
    },
    {
      "rule_id": "BR_007",
      "rule_name": "Time of Day Product Suggestions",
      "category": "Recommendation Engine",
      "description": "Product suggestions depending on the time of day.",
      "logic": "IF time BETWEEN 06:00 AND 09:00 THEN recommend [Milk, Eggs, Bread]. IF time > 22:00 THEN recommend [Condoms, Chips, Antacids]."
    },
    {
      "rule_id": "BR_008",
      "rule_name": "COD Ban",
      "category": "Risk Management",
      "description": "IF a customer is refusing the order upon COD at doorsteps, and if it happens twice in a month, THEN COD option will be disabled for that user permanently.",
      "logic": "IF count(cod_rejections) >= 2 IN trailing_30_days THEN set cod_eligible = FALSE."
    },
    {
      "rule_id": "BR_009",
      "rule_name": "The Heavy Order Split",
      "category": "Logistics Management",
      "description": "IF a rider is assigned a order weighing over 15kg THEN that order will be distributed among 2 riders.",
      "logic": "IF order_weight_kg > 15 THEN split_order(order_id, 2_riders)."
    },
    {
      "rule_id": "BR_010",
      "rule_name": "Dynamic Weather Fees",
      "category": "Dynamic Pricing",
      "description": "IF temperatures cross 42°C or rain exceeds a certain threshold, THEN automatically apply a Weather Surge Fee.",
      "logic": "IF temperature >= 42 OR rainfall_mm >= threshold THEN apply fee('Weather Surge', 15.00) AND allocate 70% to rider."
    },
    {
      "rule_id": "BR_011",
      "rule_name": "Standard vs Premium Membership Hierarchy",
      "category": "Fulfillment Prioritization",
      "description": "Premium customers are preferred over Standard customers. Their order gets placed at the top of the picking queue.",
      "logic": "IF customer_membership == 'Quick Pass' THEN queue_priority = 1 ELSE queue_priority = 2."
    },
    {
      "rule_id": "BR_012",
      "rule_name": "Peak Hour Pricing",
      "category": "Dynamic Pricing",
      "description": "During 6 PM - 10 PM the delivery pricing increases slightly.",
      "logic": "IF time BETWEEN 18:00 AND 22:00 THEN apply fee('Peak Hour Surge', 10.00)."
    },
    {
      "rule_id": "BR_013",
      "rule_name": "Distance Wise Delivery Charges",
      "category": "Pricing Strategy",
      "description": "With increase in distance between the dark store and delivery address the delivery charge increases, keeping free delivery upto 4km.",
      "logic": "IF distance_km <= 4 THEN delivery_fee = 0 ELSE delivery_fee = (distance_km - 4) * 10."
    },
    {
      "rule_id": "BR_014",
      "rule_name": "Market Basket Analysis",
      "category": "Cross-Selling",
      "description": "IF a customer is adding diapers in the cart, THEN baby care products are suggested accordingly during checkout.",
      "logic": "IF cart CONTAINS category('Diapers') THEN trigger_recommendation_carousel('Baby Care Products')."
    },
    {
      "rule_id": "BR_015",
      "rule_name": "Weekend Behaviour",
      "category": "Demand Patterns",
      "description": "Most orders are placed during Friday and Saturday evening.",
      "logic": "IF day IN ['Friday', 'Saturday'] AND time BETWEEN 17:00 AND 23:59 THEN total_order_volume_multiplier = 1.6."
    },
    {
      "rule_id": "BR_016",
      "rule_name": "The Markdown Rule (FEFO)",
      "category": "Inventory Liquidation",
      "description": "IF a batch of bread or milk is within 24 hours of its expiry date, THEN apply a 50% discount banner.",
      "logic": "IF (item_expiry_date - current_date) <= 24_HOURS AND category IN ['Dairy', 'Bakery'] THEN apply_discount(item_id, 0.50)."
    }
  ]
}